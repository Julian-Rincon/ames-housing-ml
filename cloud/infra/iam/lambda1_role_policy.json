{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ControlTheCpuEngineInstance",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:CreateTags"],
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/${INSTANCE_ID}"
    },
    {
      "Sid": "DescribeInstancesNotResourceScopable",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/lambda/savi-start-ec2:*"
    }
  ]
}
